default_platform(:ios)

# Builds Stride and uploads to TestFlight in one lane. Uses an App Store
# Connect API key throughout — no certificates or profiles committed
# anywhere in the repo.
#
# Explicitly fetches a Distribution certificate and App Store provisioning
# profiles up front (cert/sigh), then builds with manual signing pointed at
# exactly those. Automatic signing during `archive` kept defaulting to a
# Development certificate no matter what export/method hints were given —
# and since every CI run is a fresh disposable machine with no local private
# key, that path could never succeed anyway (each run just found the
# previous run's now-orphaned Development cert and got stuck). Fetching
# Distribution assets directly sidesteps that guessing entirely.
platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["KEY_ID"],
      issuer_id: ENV["ISSUER_ID"],
      key_filepath: ENV["API_KEY_PATH"]
    )

    get_certificates(
      development: false,
      api_key: api_key
    )

    # No `type:` param — App Store distribution is the default when
    # development/adhoc/developer_id are all left unset.
    get_provisioning_profile(
      app_identifier: "com.ramlankalapalli.stride",
      api_key: api_key
    )

    get_provisioning_profile(
      app_identifier: "com.ramlankalapalli.stride.widget",
      api_key: api_key
    )

    build_app(
      project: "Stride.xcodeproj",
      scheme: "Stride",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual"
      },
      xcargs: "CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=#{ENV['TEAM_ID']}"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
