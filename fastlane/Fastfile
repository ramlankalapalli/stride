default_platform(:ios)

# Builds Stride and uploads to TestFlight in one lane.
#
# Uses `match` to store the Distribution certificate + provisioning
# profiles encrypted inside this same repo (git storage, no separate repo
# needed — reuses this run's own GITHUB_TOKEN). This exists because every CI
# run is a brand-new disposable machine: fetching a fresh certificate each
# time hit Apple's per-account certificate limit almost immediately. match
# creates it once and every subsequent run reuses the same cert+key instead
# of minting a new one.
platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["KEY_ID"],
      issuer_id: ENV["ISSUER_ID"],
      key_filepath: ENV["API_KEY_PATH"]
    )

    match_git_url = "https://x-access-token:#{ENV['GH_TOKEN']}@github.com/ramlankalapalli/stride.git"

    # One app identifier per call — each call's fetched profile path is
    # captured immediately via the singular shared value before the next
    # call overwrites it.
    match(
      type: "appstore",
      app_identifier: "com.ramlankalapalli.stride",
      git_url: match_git_url,
      git_branch: "match-certs",
      api_key: api_key,
      readonly: false
    )
    app_profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]

    match(
      type: "appstore",
      app_identifier: "com.ramlankalapalli.stride.widget",
      git_url: match_git_url,
      git_branch: "match-certs",
      api_key: api_key,
      readonly: false
    )
    widget_profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]

    # match fetches the cert/profiles but doesn't wire per-target profiles
    # into the project file — xcargs can't express "different profile per
    # target" either, so do it explicitly.
    update_project_provisioning(
      xcodeproj: "Stride.xcodeproj",
      target_filter: "Stride",
      profile: app_profile_path,
      build_configuration: "Release"
    )

    update_project_provisioning(
      xcodeproj: "Stride.xcodeproj",
      target_filter: "StrideWidget",
      profile: widget_profile_path,
      build_configuration: "Release"
    )

    build_app(
      project: "Stride.xcodeproj",
      scheme: "Stride",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual"
      },
      xcargs: "CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=#{ENV['TEAM_ID']}"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
