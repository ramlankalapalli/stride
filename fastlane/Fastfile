default_platform(:ios)

# Builds Stride and uploads to TestFlight in one lane. Uses an App Store
# Connect API key throughout — no certificates or profiles committed
# anywhere in the repo.
#
# Explicitly fetches a Distribution certificate and per-target App Store
# provisioning profiles up front (cert/sigh), writes each profile directly
# into the matching target's build settings (update_project_provisioning),
# then builds. Automatic signing during `archive` kept defaulting to a
# Development certificate no matter what export/method hints were given, and
# xcargs can't express "different profile per target" since it applies one
# value across the whole project — hence doing this explicitly instead.
platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["KEY_ID"],
      issuer_id: ENV["ISSUER_ID"],
      key_filepath: ENV["API_KEY_PATH"]
    )

    get_certificates(
      development: false,
      api_key: api_key
    )

    app_profile_path = get_provisioning_profile(
      app_identifier: "com.ramlankalapalli.stride",
      api_key: api_key
    )
    app_profile_name = lane_context[SharedValues::SIGH_PROFILE_NAME]

    widget_profile_path = get_provisioning_profile(
      app_identifier: "com.ramlankalapalli.stride.widget",
      api_key: api_key
    )
    widget_profile_name = lane_context[SharedValues::SIGH_PROFILE_NAME]

    update_project_provisioning(
      xcodeproj: "Stride.xcodeproj",
      target_filter: "Stride",
      profile: app_profile_path,
      build_configuration: "Release"
    )

    update_project_provisioning(
      xcodeproj: "Stride.xcodeproj",
      target_filter: "StrideWidget",
      profile: widget_profile_path,
      build_configuration: "Release"
    )

    build_app(
      project: "Stride.xcodeproj",
      scheme: "Stride",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.ramlankalapalli.stride" => app_profile_name,
          "com.ramlankalapalli.stride.widget" => widget_profile_name
        }
      },
      xcargs: "CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=#{ENV['TEAM_ID']}"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
