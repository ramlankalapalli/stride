default_platform(:ios)

# Builds Stride and uploads to TestFlight in one lane.
#
# Uses `match` to store the Distribution certificate + provisioning
# profiles encrypted inside this same repo (git storage, no separate repo
# needed — reuses this run's own GITHUB_TOKEN). This exists because every CI
# run is a brand-new disposable machine: fetching a fresh certificate each
# time hit Apple's per-account certificate limit almost immediately. match
# creates it once and every subsequent run reuses the same cert+key instead
# of minting a new one.
platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    UI.important("MARK: start #{Time.now}")

    api_key = app_store_connect_api_key(
      key_id: ENV["KEY_ID"],
      issuer_id: ENV["ISSUER_ID"],
      key_filepath: ENV["API_KEY_PATH"]
    )
    UI.important("MARK: got api_key #{Time.now}")

    match_git_url = "https://x-access-token:#{ENV['GH_TOKEN']}@github.com/ramlankalapalli/stride.git"
    app_id = "com.ramlankalapalli.stride"
    widget_id = "com.ramlankalapalli.stride.widget"

    match(
      type: "appstore",
      app_identifier: [app_id, widget_id],
      git_url: match_git_url,
      git_branch: "match-certs",
      api_key: api_key,
      readonly: false
    )
    UI.important("MARK: match done #{Time.now}")

    # match fetches the cert/profiles but doesn't wire per-target profiles
    # into the project file, and xcargs can't express "different profile per
    # target" — so do it explicitly. Confirmed via a debug run that match
    # sets these exact ENV keys: sigh_<bundle id>_appstore_profile-path.
    # target_filter is a regex — plain "Stride" also matches "StrideWidget"
    # as a substring, which was silently corrupting the widget's settings
    # right before the next call fixed them again. Anchor it.
    update_project_provisioning(
      xcodeproj: "Stride.xcodeproj",
      target_filter: "^Stride$",
      profile: ENV["sigh_#{app_id}_appstore_profile-path"],
      build_configuration: "Release",
      code_signing_identity: "Apple Distribution"
    )
    UI.important("MARK: provisioning 1 done #{Time.now}")

    update_project_provisioning(
      xcodeproj: "Stride.xcodeproj",
      target_filter: "StrideWidget",
      profile: ENV["sigh_#{widget_id}_appstore_profile-path"],
      build_configuration: "Release",
      code_signing_identity: "Apple Distribution"
    )
    UI.important("MARK: provisioning 2 done #{Time.now}")

    # Confirmed via a resolved-build-settings dump: update_project_provisioning
    # correctly set PROVISIONING_PROFILE_SPECIFIER per target, but its
    # code_signing_identity: param silently did not persist — the project
    # still resolved to "Apple Development". Force it directly on the
    # archive command instead, which is guaranteed to apply.
    build_app(
      project: "Stride.xcodeproj",
      scheme: "Stride",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          app_id => ENV["sigh_#{app_id}_appstore_profile-name"],
          widget_id => ENV["sigh_#{widget_id}_appstore_profile-name"]
        }
      },
      xcargs: "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=\"Apple Distribution\" DEVELOPMENT_TEAM=#{ENV['TEAM_ID']}"
    )
    UI.important("MARK: build_app done #{Time.now}")

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
    UI.important("MARK: upload done #{Time.now}")
  end
end
