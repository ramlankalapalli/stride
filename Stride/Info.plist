<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<!-- TODO(open): §9 — final app name unconfirmed. -->
	<string>Stride</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- §8: Core Motion entitlement. -->
	<key>NSMotionUsageDescription</key>
	<string>Step count only, nothing else. No location, no GPS.</string>

	<!-- §8: HealthKit, read-only, stepCount only. -->
	<key>NSHealthShareUsageDescription</key>
	<string>Stride reads your step count from Health to combine phone and Watch data. Nothing else is read, nothing is written.</string>
	<!-- Apple's static scan flags any reference to
	     HKHealthStore.requestAuthorization(toShare:read:) and requires this
	     key even when the toShare set is empty (StepProvider.swift never
	     actually writes). -->
	<key>NSHealthUpdateUsageDescription</key>
	<string>Stride does not write to Health. This is required because the app calls an API that could, in principle, request write access — the request itself is always empty.</string>

	<key>UIAppFonts</key>
	<array>
		<string>Archivo-Regular.ttf</string>
		<string>Archivo-Medium.ttf</string>
		<string>Archivo-SemiBold.ttf</string>
		<string>Archivo-Bold.ttf</string>
		<string>Archivo-ExtraBold.ttf</string>
		<string>Archivo-Black.ttf</string>
		<string>JetBrainsMono-Regular.ttf</string>
		<string>JetBrainsMono-Medium.ttf</string>
	</array>

	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.ramlankalapalli.stride.midnight-rollover</string>
	</array>

	<!-- Declares encryption use directly instead of leaving it unanswered —
	     otherwise every single build sits on "Missing Compliance" in App
	     Store Connect until someone manually answers the same question
	     again. Stride does no networking and no custom crypto. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
